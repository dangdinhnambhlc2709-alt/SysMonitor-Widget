<ui:FluentWindow x:Class="WinHardwareMonitor.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:WinHardwareMonitor.Controls"
                 xmlns:services="clr-namespace:WinHardwareMonitor.Services"
                 Title="{Binding [WindowTitle], Source={x:Static services:LocalizationService.Instance}}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 FlowDirection="{Binding FlowDirection, Source={x:Static services:LocalizationService.Instance}}"
                 Width="1120"
                 Height="780"
                 MinWidth="920"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Window.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1EFFFFFF" />
                    <Setter Property="BorderBrush" Value="#4860CDFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1860CDFF" />
                    <Setter Property="BorderBrush" Value="#6660CDFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveMetricItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectableMetricListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#10FFFFFF"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3860CDFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2460CDFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9960CDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề chuẩn Windows 11 kèm biểu tượng chính thức -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding [AppTitle], Source={x:Static services:LocalizationService.Instance}}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Thanh trạng thái & hành động nhanh -->
        <Border Grid.Row="1"
                Margin="20,4,20,10"
                Padding="14,9"
                Background="#12FFFFFF"
                BorderBrush="#1CFFFFFF"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Padding="9,4" Margin="0,0,8,2" CornerRadius="12" Background="#16FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FACC15" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter Property="Fill" Value="#4ADE80" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AdminStatusText}" FontSize="12" Foreground="#E5FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Padding="9,4" Margin="0,0,8,2" CornerRadius="12" Background="#1860CDFF">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash20" FontSize="13" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding HotkeyStatusText}" FontSize="12" Foreground="#E5FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding [BtnResetFps], Source={x:Static services:LocalizationService.Instance}}"
                               Command="{Binding ResetFpsStatsCommand}"
                               Appearance="Secondary" Padding="10,6" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding WidgetVisibilityButtonText}"
                               Command="{Binding ToggleWidgetVisibilityCommand}"
                               Appearance="Secondary" Padding="11,6" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding [BtnCenterWidget], Source={x:Static services:LocalizationService.Instance}}"
                               Command="{Binding CenterWidgetCommand}"
                               Appearance="Secondary" Padding="11,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nội dung chính chia 4 Tab chuẩn Windows 11 -->
        <TabControl Grid.Row="2"
                    Margin="20,0,20,10"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- ================================================================ -->
            <!-- TAB 1: TỔNG QUAN & KÉO THẢ -->
            <!-- ================================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:SymbolIcon Symbol="AppsList24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [TabOverview], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" MinWidth="460" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding [AvailableMetricsTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15.5" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{Binding [AvailableMetricsSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#A8FFFFFF" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="#1260CDFF" BorderBrush="#2E60CDFF" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,12">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Tải PresentMon" Command="{Binding DownloadPresentMonCommand}" Appearance="Secondary" Padding="9,4" FontSize="11.5" Margin="8,0,0,0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPresentMonAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FACC15" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPresentMonRunning}" Value="True">
                                                        <Setter Property="Fill" Value="#4ADE80" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Text="{Binding FpsStatusText}" FontSize="11.5" Foreground="#E8FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding AvailableGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14">
                                                <DockPanel Margin="2,0,8,8">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="#60CDFF" VerticalAlignment="Center" />
                                                    <TextBlock Text="•" Margin="7,0" Foreground="#55FFFFFF" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource MetricCardStyle}"
                                                                    PreviewMouseLeftButtonDown="AvailableCard_PreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="AvailableCard_PreviewMouseMove">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                                                        <Button DockPanel.Dock="Right"
                                                                                Command="{Binding DataContext.ToggleMetricCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" Padding="8,3" MinWidth="60" FontSize="11.5" Cursor="Hand">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                    <Setter Property="Content" Value="+ Thêm" />
                                                                                    <Setter Property="Background" Value="#20FFFFFF" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                            <Setter Property="Content" Value="✓ Đã bật" />
                                                                                            <Setter Property="Background" Value="#2E60CDFF" />
                                                                                            <Setter Property="Foreground" Value="#8AE0FF" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>

                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}" FontSize="15" Foreground="#C8FFFFFF" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DockPanel>

                                                                    <DockPanel Grid.Row="1" Margin="0,7,0,0">
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedValue}" FontSize="13" FontWeight="SemiBold" Foreground="#60CDFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    </DockPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" x:Name="ActiveDropZoneBorder" Style="{StaticResource SectionCardStyle}"
                            AllowDrop="True" DragEnter="ActiveList_DragOver" DragOver="ActiveList_DragOver" DragLeave="ActiveList_DragLeave" Drop="ActiveList_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" Padding="9,3" CornerRadius="10" Background="#2260CDFF" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveMetricCountText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8AE0FF" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding [ActiveWidgetTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15.5" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding [ActiveWidgetSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="ActiveMetricsListBox"
                                         ItemsSource="{Binding ActiveMetrics}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource ActiveMetricItemContainerStyle}"
                                         PreviewMouseLeftButtonDown="ActiveList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="ActiveList_PreviewMouseMove">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,7" Cursor="SizeAll">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#B0FFFFFF" Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveMetricCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />

                                                    <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="2,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.CustomizeMetricCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="PaintBrush16" FontSize="13" Foreground="#B8FFFFFF" />
                                                    </Button>

                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedValue}" FontSize="12.5" FontWeight="SemiBold" Foreground="#60CDFF" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="8,0,6,0" />

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}" FontSize="14" Foreground="#D0FFFFFF" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="12.5" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Title}" FontSize="10.5" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Background="#0BFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="8" Padding="16" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveMetrics}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Kéo thả thẻ thông số từ cột bên trái vào đây để hiển thị trên Widget nổi" FontSize="12" Foreground="#88FFFFFF" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================ -->
            <!-- TAB 2: TÙY BIẾN TỪNG MỤC -->
            <!-- ================================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:SymbolIcon Symbol="PaintBrush24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [TabCustomize], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <ui:Button Content="{Binding [BtnTextAll], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ApplyHeaderStyleAllCommand}" CommandParameter="text" Appearance="Secondary" Padding="9,5" Margin="0,0,6,2" />
                                <ui:Button Content="{Binding [BtnIconAll], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ApplyHeaderStyleAllCommand}" CommandParameter="icon" Appearance="Secondary" Padding="9,5" Margin="0,0,10,2" />
                                <ui:Button Content="{Binding [BtnHighlightAll], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding HighlightAllMetricsCommand}" CommandParameter="on" Appearance="Primary" Padding="9,5" Margin="0,0,6,2" />
                                <ui:Button Content="{Binding [BtnUnhighlightAll], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding HighlightAllMetricsCommand}" CommandParameter="off" Appearance="Secondary" Padding="9,5" Margin="0,0,10,2" />
                                <ui:Button Content="{Binding [BtnResetAll], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetAllMetricStylesCommand}" Appearance="Secondary" Padding="9,5" Margin="0,0,0,2" />
                            </WrapPanel>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [BulkApplyTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{Binding [BulkApplySub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" MinWidth="290" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.45*" MinWidth="460" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <CheckBox DockPanel.Dock="Right" Content="{Binding [OnlyActive], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding ShowOnlyActiveInCustomization, Mode=TwoWay}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [SelectMetric], Source={x:Static services:LocalizationService.Instance}}" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                </DockPanel>

                                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredCustomizationMetrics}" SelectedItem="{Binding SelectedCustomizationMetric, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource SelectableMetricListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#60CDFF" Margin="0,0,6,0" Visibility="{Binding HasCustomizations, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding FormattedValue}" FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF" Typography.NumeralAlignment="Tabular" />
                                                </StackPanel>

                                                <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}" FontSize="15" Foreground="{Binding EffectiveLabelBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="11" Foreground="#99FFFFFF" />
                                                        <TextBlock Text=" • " FontSize="11" Foreground="#55FFFFFF" />
                                                        <TextBlock Text="{Binding HeaderStyleLabel}" FontSize="11" Foreground="#8AE0FF" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                <StackPanel Visibility="{Binding HasSelectedCustomizationMetric, Converter={StaticResource BoolToVis}}">
                                    <DockPanel Margin="0,0,0,12">
                                        <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnResetMetric], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetSelectedMetricCommand}" Appearance="Secondary" Padding="10,5" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedCustomizationMetric.Title}" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding SelectedCustomizationMetric.GroupSubtitle}" FontSize="11.5" Foreground="#90FFFFFF" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="#10000000" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding [LivePreview], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0" />

                                            <Border HorizontalAlignment="Left" Background="{Binding WidgetBackgroundBrush}" BorderBrush="{Binding WidgetBorderBrush}" BorderThickness="{Binding WidgetBorderThickness}" CornerRadius="{Binding EffectiveWidgetCornerRadius}" Padding="14,10">
                                                <Border Background="{Binding SelectedCustomizationMetric.BlockBackgroundBrush}" BorderBrush="{Binding SelectedCustomizationMetric.BlockBorderBrush}" BorderThickness="{Binding SelectedCustomizationMetric.BlockBorderThickness}" Padding="{Binding SelectedCustomizationMetric.BlockPadding}" CornerRadius="{Binding SelectedCustomizationMetric.BlockCornerRadius}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Direction="270" Color="#000000"
                                                                          ShadowDepth="{Binding SelectedCustomizationMetric.BlockShadowDepth}"
                                                                          BlurRadius="{Binding SelectedCustomizationMetric.BlockShadowBlur}"
                                                                          Opacity="{Binding SelectedCustomizationMetric.BlockShadowOpacity}" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="{Binding SelectedCustomizationMetric.EffectiveSymbol}" FontSize="{Binding WidgetIconFontSize}" Foreground="{Binding SelectedCustomizationMetric.EffectiveLabelBrush}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding SelectedCustomizationMetric.IsIconHeader, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding SelectedCustomizationMetric.DisplayLabel}" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding WidgetLabelFontSize}" FontWeight="{Binding WidgetLabelFontWeight}" Foreground="{Binding SelectedCustomizationMetric.EffectiveLabelBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding SelectedCustomizationMetric.IsTextHeader, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding SelectedCustomizationMetric.FormattedValue}" FontFamily="{Binding SelectedFontFamily}" FontSize="{Binding FontSize}" FontWeight="{Binding WidgetValueFontWeight}" Foreground="{Binding SelectedCustomizationMetric.EffectiveValueBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <controls:FpsGraphControl Width="170" Height="{Binding FpsGraphHeight}" Margin="0,5,0,0" Points="{Binding FpsGraphHistory}" BaseLineBrush="{Binding FpsGraphBaseBrush}" FrameGenLineBrush="{Binding FpsGraphFrameGenBrush}" Visibility="{Binding SelectedCustomizationMetric.IsGraphMetric, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="{Binding [DisplayNameLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E8FFFFFF" Margin="0,0,0,6" />
                                    <DockPanel Margin="0,0,0,14">
                                        <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnResetName], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetSelectedMetricLabelCommand}" Appearance="Secondary" Padding="10,6" Margin="8,0,0,0" />
                                        <ui:TextBox Text="{Binding SelectedCustomizationMetric.CustomLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Để trống để dùng tên mặc định..." />
                                    </DockPanel>

                                    <Border Background="#10FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding [HighlightBlockTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding [HighlightBlockSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedCustomizationMetric.IsHighlightedBlock, Mode=TwoWay}" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Thanh trượt Mức độ nổi khối (0% phẳng tối giản -> 100% nổi khối 3D rõ nét) -->
                                            <StackPanel Margin="0,12,0,0" IsEnabled="{Binding SelectedCustomizationMetric.IsHighlightedBlock}">
                                                <DockPanel Margin="0,0,0,4">
                                                    <ui:Button DockPanel.Dock="Right"
                                                               Content="Áp dụng mức này cho tất cả"
                                                               Command="{Binding ApplySelectedHighlightIntensityAllCommand}"
                                                               Appearance="Secondary"
                                                               Padding="8,3"
                                                               FontSize="11"
                                                               Margin="8,0,0,0" />
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding SelectedCustomizationMetric.HighlightIntensityLabel}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#60CDFF"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Mức độ nổi khối (0%: phẳng tối giản → 100%: nổi 3D)"
                                                               FontSize="12"
                                                               Foreground="#DCE0E8"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Value="{Binding SelectedCustomizationMetric.HighlightIntensity, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#10FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [HeaderStyleTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <RadioButton Content="{Binding [HeaderStyleText], Source={x:Static services:LocalizationService.Instance}}" GroupName="MetricHeaderStyleGroup" IsChecked="{Binding SelectedCustomizationMetric.IsTextHeader, Mode=TwoWay}" Foreground="White" Margin="0,0,22,0" />
                                                <RadioButton Content="{Binding [HeaderStyleIcon], Source={x:Static services:LocalizationService.Instance}}" GroupName="MetricHeaderStyleGroup" IsChecked="{Binding SelectedCustomizationMetric.IsIconHeader, Mode=TwoWay}" Foreground="White" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding [PickIconLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding FluentIconChoices}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectMetricIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SymbolName}" ToolTip="{Binding Name}"
                                                                Width="34" Height="34" Margin="0,0,6,6" Padding="0" Cursor="Hand" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                                                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="White" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#10FFFFFF" BorderBrush="#2460CDFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="{Binding SelectedCustomizationMetric.IsGraphMetric, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Tùy chỉnh Đồ thị FPS" FontSize="13" FontWeight="SemiBold" Foreground="#8AE0FF" Margin="0,0,0,10" />
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FpsGraphHeightLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                <TextBlock Text="{Binding [FpsGraphHeightLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#E0FFFFFF" />
                                            </DockPanel>
                                            <Slider Minimum="24" Maximum="140" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding FpsGraphHeight, Mode=TwoWay}" Margin="0,0,0,10" />

                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding FpsGraphBaseBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                    <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding FpsGraphBaseColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding [FpsBaseLineColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#DCE0E8" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding TextColorPresets}" Margin="0,0,0,10">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectFpsGraphBaseColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="22" Height="22" Margin="0,0,5,4" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding FpsGraphFrameGenBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                    <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding FpsGraphFrameGenColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding [FpsFgLineColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#DCE0E8" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding TextColorPresets}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectFpsGraphFrameGenColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="22" Height="22" Margin="0,0,5,4" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#10FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [CustomColorsTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />

                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding SelectedCustomizationMetric.EffectiveLabelBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                    <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding SelectedCustomizationMetric.CustomLabelColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ui:Button Content="{Binding [BtnDefaultColor], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ClearSelectedLabelColorCommand}" Appearance="Secondary" Padding="8,4" FontSize="11" Margin="6,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding [LabelColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#DCE0E8" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding TextColorPresets}" Margin="0,0,0,12">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectMetricLabelColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="24" Height="24" Margin="0,0,6,4" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                            <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding SelectedCustomizationMetric.EffectiveValueBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                    <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding SelectedCustomizationMetric.CustomValueColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ui:Button Content="{Binding [BtnDefaultColor], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ClearSelectedValueColorCommand}" Appearance="Secondary" Padding="8,4" FontSize="11" Margin="6,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding [ValueColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#DCE0E8" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding TextColorPresets}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectMetricValueColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="24" Height="24" Margin="0,0,6,4" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                            <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1.2" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================================================ -->
            <!-- TAB 3: CÔNG NGHỆ GPU & GHI ĐÈ NHANH THEO GAME -->
            <!-- ================================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:SymbolIcon Symbol="Games24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [TabGpuTech], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>
                        <!-- 1. Khung quét GPU & Bộ lọc hãng -->
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [HideUnsupported], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:ToggleSwitch IsChecked="{Binding HideUnsupportedGpuTechs, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [GpuDetectedTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding [GpuDetectedSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding DetectedGpus}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding VendorAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="12" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <WrapPanel VerticalAlignment="Center">
                                        <RadioButton Content="{Binding [GpuAutoAll], Source={x:Static services:LocalizationService.Instance}}" GroupName="GpuSelectionModeGroup" IsChecked="{Binding IsAutoAllGpusMode, Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" Margin="0,0,22,4" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <RadioButton Content="{Binding [GpuSinglePrimary], Source={x:Static services:LocalizationService.Instance}}" GroupName="GpuSelectionModeGroup" IsChecked="{Binding IsSinglePrimaryGpuMode, Mode=TwoWay}" IsEnabled="{Binding HasDetectedGpus}" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ComboBox ItemsSource="{Binding DetectedGpus}" SelectedItem="{Binding SelectedPrimaryGpu, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" MinWidth="280" IsEnabled="{Binding IsSinglePrimaryGpuMode}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Màu huy hiệu công nghệ trên Widget -->
                                <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [BadgeColorTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                        <WrapPanel VerticalAlignment="Center">
                                            <RadioButton Content="{Binding [BadgeColorVendor], Source={x:Static services:LocalizationService.Instance}}" GroupName="GpuBadgeColorMode" IsChecked="{Binding UseVendorGpuBadgeColor, Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,4" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <RadioButton Content="{Binding [BadgeColorCustom], Source={x:Static services:LocalizationService.Instance}}" GroupName="GpuBadgeColorMode" IsChecked="{Binding UseCustomGpuBadgeColor, Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding CustomGpuBadgePreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBox Width="88" FontSize="11.5" Padding="6,3" Text="{Binding CustomGpuBadgeColorHex, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomGpuBadgeColor}" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2. Ghi đè nhanh cho game đang chạy (nhớ theo tên .exe) -->
                        <Border Style="{StaticResource SectionCardStyle}" BorderBrush="#3C60CDFF" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Đặt lại tự động" Command="{Binding ClearCurrentGameOverridesCommand}" Appearance="Secondary" Padding="10,5" IsEnabled="{Binding HasOverrideTargetGame}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding [QuickOverrideTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="#8AE0FF" />
                                        <TextBlock Text="{Binding [QuickOverrideSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#A0FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Trạng thái bộ quét DLL / Anti-Cheat -->
                                <Border Background="#1260CDFF" CornerRadius="7" Padding="10,6" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding GpuDetectionStatusText}" FontSize="11.5" Foreground="#E5FFFFFF" TextWrapping="Wrap" />
                                </Border>

                                <!-- Chọn hồ sơ .exe đang chạy / đã lưu hoặc thêm thủ công -->
                                <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverrideTargetGameDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ComboBox ItemsSource="{Binding SavedGameProfileNames}" SelectedItem="{Binding CurrentOverrideGameExe, Mode=TwoWay}" MinWidth="180" Margin="0,0,10,6" ToolTip="Chọn hồ sơ game (.exe) đã phát hiện hoặc đã lưu" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:TextBox Width="175" Text="{Binding ManualGameExeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Nhập tên game.exe..." Margin="0,0,6,0" />
                                        <ui:Button Content="Tạo / Chọn" Command="{Binding ApplyManualGameExeCommand}" Appearance="Secondary" Padding="10,6" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Xem trước huy hiệu đang hiển thị trên Widget -->
                                <Border Background="#10000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="Huy hiệu trên Widget:" FontSize="11.5" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ItemsControl ItemsSource="{Binding ActiveGpuBadges}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,1,6,1">
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding TextBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>

                                <!-- Nút bấm chu kỳ (Tự động -> Bật thủ công -> Tắt thủ công) cho từng công nghệ khả dụng -->
                                <ItemsControl ItemsSource="{Binding SupportedGpuTechItems}" IsEnabled="{Binding HasOverrideTargetGame}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.CycleTechOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="10,7" Margin="0,0,8,8" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#14FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#24FFFFFF" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverrideForceOn}" Value="True">
                                                                <Setter Property="Background" Value="#284ADE80" />
                                                                <Setter Property="BorderBrush" Value="#AA4ADE80" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOverrideForceOff}" Value="True">
                                                                <Setter Property="Background" Value="#24F87171" />
                                                                <Setter Property="BorderBrush" Value="#99F87171" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="6" Background="#20000000" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OverrideLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                                                        <TextBlock Text="{Binding AutoDetectedLabel}" FontSize="10.5" Foreground="#99FFFFFF" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 3. 3 Nhóm công nghệ: NVIDIA / AMD / Intel -->
                        <ItemsControl ItemsSource="{Binding GpuTechGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12"
                                            Opacity="{Binding GroupOpacity}" IsEnabled="{Binding IsSupported}"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="10" Background="#1CFFFFFF" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SupportBadgeText}" FontSize="11.5" FontWeight="Medium" Foreground="#E0FFFFFF" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="4" Height="28" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,0,10,0" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#99FFFFFF" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#12FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,8,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#95FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================ -->
            <!-- TAB 4: GIAO DIỆN WIDGET, ẢNH NỀN PNG, NGÔN NGỮ & HỆ THỐNG -->
            <!-- ================================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:SymbolIcon Symbol="DesktopEdit24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [TabWidget], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Luôn hiện Widget trên các ứng dụng khác" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Giữ Widget luôn nổi trên cùng các cửa sổ làm việc, trình duyệt và game (Borderless). Tắt để Widget ẩn xuống dưới khi chuyển sang ứng dụng khác."
                                                       FontSize="11.5" Foreground="#A0FFFFFF" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsWidgetTopmost, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Height="1" Background="#1CFFFFFF" Margin="0,0,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [ClickThroughTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding [ClickThroughSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#A0FFFFFF" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ClickThroughStatusLabel}" FontSize="12" FontWeight="Medium" Foreground="#60CDFF" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsClickThrough, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding [BgFrameTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <!-- 3 chế độ hiệu ứng nền Windows 11 (Tắt làm mờ / Kính mềm / Kính mờ) -->
                                    <Border Background="#10FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Hiệu ứng nền kính (Windows 11)" FontSize="12.5" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />

                                            <RadioButton GroupName="WidgetBlurModeGroup" IsChecked="{Binding IsBlurOff, Mode=TwoWay}" Foreground="White" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <TextBlock Text="Tắt làm mờ (Nhẹ nhất khi chơi game)" FontSize="12.5" FontWeight="Medium" Foreground="White" />
                                                    <TextBlock Text="Chỉ dùng màu nền phẳng theo thanh trượt độ đậm, tắt hoàn toàn hiệu ứng DWM." FontSize="11" Foreground="#90FFFFFF" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton GroupName="WidgetBlurModeGroup" IsChecked="{Binding IsSoftGlass, Mode=TwoWay}" Foreground="White" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <TextBlock Text="Kính mềm (Liquid Glass / Soft Glass)" FontSize="12.5" FontWeight="Medium" Foreground="#8AE0FF" />
                                                    <TextBlock Text="Làm mờ nhẹ giữ đường nét mềm phía sau, viền phản quang trắng sáng sắc nét và ánh bóng kính." FontSize="11" Foreground="#90FFFFFF" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton GroupName="WidgetBlurModeGroup" IsChecked="{Binding IsFrostedGlass, Mode=TwoWay}" Foreground="White">
                                                <StackPanel>
                                                    <TextBlock Text="Kính mờ (Frosted Glass / Acrylic)" FontSize="12.5" FontWeight="Medium" Foreground="#C4B5FD" />
                                                    <TextBlock Text="Kính phun cát tán nhòe sâu chuẩn Windows 11 (Acrylic), viền siêu mảnh dịu mắt và bo góc khít." FontSize="11" Foreground="#90FFFFFF" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tự động co giãn nội dung theo kích thước cửa sổ Widget -->
                                    <Border Background="#10FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Tự động co giãn nội dung theo kích thước cửa sổ" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                    <Border Background="#2060CDFF" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ContentScalePercentText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8AE0FF" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Kéo cạnh/góc phóng to hoặc thu nhỏ Widget sẽ tự tỷ lệ hóa chữ, icon, thẻ nổi khối và đồ thị sắc nét." FontSize="11" Foreground="#90FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoScaleContent, Mode=TwoWay}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundOpacityLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        <TextBlock Text="{Binding [BgOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity, Mode=TwoWay}" Margin="0,0,0,14" />

                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding [BgToneLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Content="{Binding [BgDark], Source={x:Static services:LocalizationService.Instance}}" GroupName="WidgetBgToneGroup" IsChecked="{Binding IsDarkBackground, Mode=TwoWay}" Margin="0,0,16,0" Foreground="White" />
                                            <RadioButton Content="{Binding [BgLight], Source={x:Static services:LocalizationService.Instance}}" GroupName="WidgetBgToneGroup" IsChecked="{Binding IsLightBackground, Mode=TwoWay}" Foreground="White" />
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CornerRadiusLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        <TextBlock Text="{Binding [CornerRadiusLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CornerRadius, Mode=TwoWay}" Margin="0,0,0,16" />

                                    <!-- Ảnh nền PNG tùy chỉnh -->
                                    <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <ui:Button Content="{Binding [BtnChoosePng], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ChooseBackgroundImageCommand}" Appearance="Primary" Padding="10,5" Margin="0,0,6,0" />
                                                    <ui:Button Content="{Binding [BtnClearPng], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ClearBackgroundImageCommand}" Appearance="Secondary" Padding="10,5" IsEnabled="{Binding HasBackgroundImage}" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding [BgImageTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding BackgroundImageDisplayName}" FontSize="11" Foreground="#8AE0FF" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>

                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundImageOpacityLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                <TextBlock Text="{Binding [BgImageOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BackgroundImageOpacity, Mode=TwoWay}" IsEnabled="{Binding HasBackgroundImage}" Margin="0,0,0,8" />

                                            <DockPanel>
                                                <TextBlock Text="{Binding [BgImageStretchLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                <ComboBox DockPanel.Dock="Right" Width="210"
                                                          ItemsSource="{Binding StretchModeOptions}"
                                                          SelectedValuePath="Mode"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValue="{Binding BackgroundImageStretch, Mode=TwoWay}"
                                                          IsEnabled="{Binding HasBackgroundImage}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Cài đặt FPS & Đồ thị -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [FpsSettingsTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding [FpsSettingsSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [AutoHideFpsTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHideFpsWhenIdle, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [AutoHideFgTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHideFrameGenWhenInactive, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FpsGraphHeightLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        <TextBlock Text="{Binding [FpsGraphHeightLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" />
                                    </DockPanel>
                                    <Slider Minimum="24" Maximum="140" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding FpsGraphHeight, Mode=TwoWay}" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding [FpsBaseLineColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#C8FFFFFF" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding FpsGraphBaseBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding FpsGraphBaseColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding [FpsFgLineColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#C8FFFFFF" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding FpsGraphFrameGenBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding FpsGraphFrameGenColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,4,0,6">
                                        <ui:Button Content="Đặt lại bộ đếm FPS (Ctrl+Shift+R)" Command="{Binding ResetFpsStatsCommand}" Appearance="Secondary" Padding="10,5" Margin="0,0,8,4" />
                                        <ui:Button Content="Tải / Cập nhật PresentMon từ GitHub" Command="{Binding DownloadPresentMonCommand}" Appearance="Secondary" Padding="10,5" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding PresentMonPathDisplay}" FontSize="11" Foreground="#8AE0FF" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PresentMonDownloadFeedback}" FontSize="11" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- CỘT PHẢI -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding [GlobalTextTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding [GlobalTextSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,0,0,14" />

                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding [DefaultTextColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Width="20" Height="20" CornerRadius="4" Background="{Binding WidgetTextBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBox Width="96" FontSize="12" Padding="6,4" Text="{Binding TextColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding TextColorPresets}" Margin="0,0,0,16">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectColorPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="28" Height="28" Margin="0,0,8,6" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1.5" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Phông chữ cài sẵn trên Windows (hiện tên theo đúng kiểu chữ) -->
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="Phông chữ (Font)" FontSize="12.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                        <ComboBox DockPanel.Dock="Right" Width="230"
                                                  ItemsSource="{Binding InstalledFontFamilies}"
                                                  SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="13" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>

                                    <!-- Độ đậm nhạt (7 mức từ Thin đến ExtraBold) -->
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="Độ đậm nhạt (FontWeight)" FontSize="12.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                        <ComboBox DockPanel.Dock="Right" Width="230"
                                                  ItemsSource="{Binding FontWeightOptions}"
                                                  SelectedItem="{Binding SelectedFontWeightOption, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="{Binding Weight}" FontSize="12.5" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>

                                    <!-- Cỡ chữ gốc (10 đến 36) -->
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FontSizeLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        <TextBlock Text="{Binding [GlobalFontSize], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" />
                                    </DockPanel>
                                    <Slider Minimum="10" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Hệ thống, 10 Ngôn ngữ & System Tray -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SystemTrayTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding [LanguageLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                                        <ComboBox DockPanel.Dock="Right" Width="210"
                                                  ItemsSource="{Binding SupportedLanguages}"
                                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                                  DisplayMemberPath="NativeName" />
                                    </DockPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [RunAtStartupTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding [RunAtStartupSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StartupStatusFeedback}" FontSize="11" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAtWindowsStartup, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [MinToTrayTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding [MinToTraySub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cập nhật phần mềm từ GitHub Releases -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="#2260CDFF" BorderBrush="#5560CDFF" BorderThickness="1" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentVersionDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#8AE0FF" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Cập nhật phần mềm" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding GitHubRepoDisplay}" FontSize="11.5" Foreground="#90FFFFFF" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Tự động kiểm tra bản mới khi khởi động" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="Chạy ngầm sau khi mở ứng dụng 3 giây để tìm bản phát hành mới trên GitHub Releases."
                                                       FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdatesOnStartup, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Left"
                                                   Content="Kiểm tra cập nhật ngay"
                                                   Command="{Binding CheckForUpdatesCommand}"
                                                   IsEnabled="{Binding CanCheckUpdates}"
                                                   Appearance="Primary"
                                                   Padding="14,6" />
                                        <TextBlock Text="{Binding UpdateStatusMessage}"
                                                   FontSize="11.5"
                                                   Foreground="#8AE0FF"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [ConfigFileTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ConfigFilePath}" FontSize="11.5" Foreground="#8AE0FF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Thanh chân trang -->
        <Border Grid.Row="3" Margin="20,0,20,16" Padding="14,8" Background="#0EFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="{Binding [BtnResetDefaults], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetDefaultsCommand}" Appearance="Secondary" Padding="12,5" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding [BtnExitApp], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ExitAppCommand}" Appearance="Danger" Padding="12,5" />
                </StackPanel>

                <TextBlock Text="{Binding CloseBehaviorFooterText}" FontSize="11.5" Foreground="#90FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
