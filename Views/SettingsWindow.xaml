<ui:FluentWindow x:Class="WinHardwareMonitor.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:WinHardwareMonitor.Controls"
                 xmlns:services="clr-namespace:WinHardwareMonitor.Services"
                 Title="{Binding [WindowTitle], Source={x:Static services:LocalizationService.Instance}}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 FlowDirection="{Binding FlowDirection, Source={x:Static services:LocalizationService.Instance}}"
                 Width="1300"
                 Height="840"
                 MinWidth="1060"
                 MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="VaultCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1EFFFFFF" />
                    <Setter Property="BorderBrush" Value="#4860CDFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsPlacedOnGrid}" Value="True">
                    <Setter Property="Background" Value="#1860CDFF" />
                    <Setter Property="BorderBrush" Value="#6660CDFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CanvasLayerContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#FF60CDFF" BorderBrush="#FF081018" BorderThickness="1" CornerRadius="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnchorButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="Foreground" Value="#D8FFFFFF" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề chuẩn Windows 11 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding [AppTitle], Source={x:Static services:LocalizationService.Instance}}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Thanh trạng thái & thao tác nhanh -->
        <Border Grid.Row="1" Margin="18,4,18,8" Padding="12,7" Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Border Padding="9,4" Margin="0,0,8,2" CornerRadius="12" Background="#16FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FACC15" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                <Setter Property="Fill" Value="#4ADE80" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AdminStatusText}" FontSize="12" Foreground="#E5FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Padding="9,4" Margin="0,0,8,2" CornerRadius="12" Background="#1860CDFF">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash20" FontSize="13" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding HotkeyStatusText}" FontSize="12" Foreground="#E5FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="{Binding [BtnResetFps], Source={x:Static services:LocalizationService.Instance}}"
                               ToolTip="{Binding [TooltipResetFps], Source={x:Static services:LocalizationService.Instance}}"
                               Command="{Binding ResetFpsStatsCommand}"
                               Appearance="Secondary" Padding="10,5" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding WidgetVisibilityButtonText}"
                               Command="{Binding ToggleWidgetVisibilityCommand}"
                               Appearance="Primary" Padding="12,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3 TAB CHÍNH: Thiết kế Overlay (Canvas RTSS) | Công nghệ GPU | Vị trí OSD & Hệ thống -->
        <TabControl Grid.Row="2"
                    Margin="18,0,18,8"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- ================================================================ -->
            <!-- TAB 1: THIẾT KẾ OVERLAY KIỂU RTSS OVERLAY EDITOR (WYSIWYG CANVAS) -->
            <!-- ================================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:SymbolIcon Symbol="DesignIdeas24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [TabOverlayDesigner], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- THANH CÔNG CỤ KIỂU RTSS OVERLAY EDITOR (Mẫu bố cục + Thêm lớp + Lưới & Hít lưới) -->
                    <Border Grid.Row="0" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <!-- Điều khiển Lưới & Bước nhảy ở bên phải -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <CheckBox Content="{Binding [ShowGridToggle], Source={x:Static services:LocalizationService.Instance}}"
                                          IsChecked="{Binding ShowEditorGrid, Mode=TwoWay}"
                                          FontSize="11.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Content="{Binding [SnapGridToggle], Source={x:Static services:LocalizationService.Instance}}"
                                          IsChecked="{Binding SnapToGrid, Mode=TwoWay}"
                                          FontSize="11.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding GridSnapOptions}"
                                          SelectedItem="{Binding GridSnapSize, Mode=TwoWay}"
                                          Width="74" Padding="6,3" FontSize="11.5" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}{0} px}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Mẫu nhanh RTSS + Thao tác lớp ở bên trái -->
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [PresetsLabel], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="#8AE0FF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="{Binding [PresetPill], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding ApplyPresetPillCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="{Binding [PresetClassic], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding ApplyPresetClassicCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="{Binding [PresetCards], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding ApplyPresetCardsCommand}" Style="{StaticResource ToolbarButtonStyle}" />

                                <Border Width="1" Height="18" Background="#2CFFFFFF" Margin="4,0,9,0" VerticalAlignment="Center" />

                                <Button Content="{Binding [BtnAddTextLayer], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding AddStaticTextLayerCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                        Background="#2060CDFF" BorderBrush="#5560CDFF" />
                                <Button Content="{Binding [BtnAddBoxLayer], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding AddBackdropBoxLayerCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="{Binding [BtnDuplicateLayer], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding DuplicateSelectedLayerCommand}" IsEnabled="{Binding HasSelectedLayer}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="{Binding [BtnBringForward], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding BringLayerForwardCommand}" IsEnabled="{Binding HasSelectedLayer}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="{Binding [BtnSendBackward], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding SendLayerBackwardCommand}" IsEnabled="{Binding HasSelectedLayer}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="{Binding [BtnDeleteLayer], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding RemoveSelectedLayerCommand}" IsEnabled="{Binding HasSelectedLayer}" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button Content="{Binding [BtnClearCanvas], Source={x:Static services:LocalizationService.Instance}}"
                                        Command="{Binding ClearAllLayersCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- 3 KHU VỰC: Kho thông số | Bảng đen Canvas WYSIWYG | Thanh tùy chỉnh lớp -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245" MinWidth="215" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" MinWidth="380" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="355" MinWidth="310" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: KHO THÔNG SỐ (KÉO THẢ LÊN CANVAS) -->
                        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="11">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding [VaultTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding [VaultSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.8" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                                    <ItemsControl ItemsSource="{Binding AvailableGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,9">
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="#60CDFF" Margin="2,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource VaultCardStyle}"
                                                                        PreviewMouseLeftButtonDown="VaultCard_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseMove="VaultCard_PreviewMouseMove">
                                                                    <DockPanel>
                                                                        <Button DockPanel.Dock="Right"
                                                                                Command="{Binding DataContext.QuickAddMetricCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                Padding="6,2" MinWidth="24" FontSize="11" Cursor="Hand" Margin="5,0,0,0">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                    <Setter Property="Content" Value="+" />
                                                                                    <Setter Property="Background" Value="#20FFFFFF" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsPlacedOnGrid}" Value="True">
                                                                                            <Setter Property="Content" Value="✓" />
                                                                                            <Setter Property="Background" Value="#3060CDFF" />
                                                                                            <Setter Property="Foreground" Value="#8AE0FF" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>

                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <ui:SymbolIcon Symbol="{Binding DefaultSymbol}" FontSize="13" Foreground="#C8FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="136" />
                                                                                <TextBlock Text="{Binding FormattedValue}" FontSize="10.5" FontWeight="SemiBold" Foreground="#60CDFF" Typography.NumeralAlignment="Tabular" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- CỘT GIỮA: BẢNG ĐEN LƯỚI MỊN WYSIWYG KIỂU RTSS OVERLAY EDITOR -->
                        <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Thanh trạng thái PresentMon gọn 1 dòng -->
                                <Border Grid.Row="0" Background="#1260CDFF" BorderBrush="#2A60CDFF" BorderThickness="1" CornerRadius="7" Padding="9,4" Margin="0,0,0,8">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnDownloadPresentMon], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding DownloadPresentMonCommand}" Appearance="Secondary" Padding="8,2" FontSize="11" Margin="8,0,0,0">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPresentMonAvailable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FACC15" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPresentMonRunning}" Value="True">
                                                            <Setter Property="Fill" Value="#4ADE80" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding FpsStatusText}" FontSize="11" Foreground="#E5FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <!-- Bảng thiết kế đen lưới mịn WYSIWYG (hiển thị thật 100% giống OSD ngoài game) -->
                                <Border Grid.Row="1" Background="#07080B" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="CanvasSurface"
                                              Width="960"
                                              Height="560"
                                              Background="#07080B"
                                              AllowDrop="True"
                                              Focusable="True"
                                              SnapsToDevicePixels="True"
                                              PreviewMouseLeftButtonDown="CanvasSurface_PreviewMouseLeftButtonDown"
                                              DragEnter="CanvasSurface_DragOver"
                                              DragOver="CanvasSurface_DragOver"
                                              Drop="CanvasSurface_Drop">

                                            <!-- Lớp lưới mịn RTSS (DrawingBrush cập nhật từ code-behind theo ShowEditorGrid & GridSnapSize) -->
                                            <Border x:Name="CanvasGridOverlay" IsHitTestVisible="False" />

                                            <!-- Các lớp Overlay WYSIWYG kéo thả & co giãn trực tiếp -->
                                            <ItemsControl x:Name="CanvasLayersControl"
                                                          ItemsSource="{Binding OverlayLayers}"
                                                          ItemContainerStyle="{StaticResource CanvasLayerContainerStyle}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="960" Height="560" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid x:Name="LayerRootGrid"
                                                              Cursor="SizeAll"
                                                              Background="Transparent"
                                                              PreviewMouseLeftButtonDown="LayerItem_PreviewMouseLeftButtonDown"
                                                              MouseMove="LayerItem_MouseMove"
                                                              MouseLeftButtonUp="LayerItem_MouseLeftButtonUp">

                                                            <!-- Hiển thị WYSIWYG giống hệt 100% cửa sổ WidgetWindow OSD -->
                                                            <Border x:Name="LayerVisualBorder"
                                                                    Width="{Binding RenderWidth}"
                                                                    Height="{Binding RenderHeight}"
                                                                    MinWidth="20"
                                                                    MinHeight="16"
                                                                    Background="{Binding EffectiveBackgroundBrush}"
                                                                    BorderBrush="{Binding EffectiveBorderBrush}"
                                                                    BorderThickness="{Binding EffectiveBorderThickness}"
                                                                    CornerRadius="{Binding EffectiveCornerRadius}"
                                                                    Padding="{Binding EffectivePadding}"
                                                                    SnapsToDevicePixels="True">
                                                                <Grid IsHitTestVisible="False">
                                                                    <!-- 1. Lớp Nhãn chữ tĩnh (StaticText) -->
                                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                                               FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               FontSize="{Binding EffectiveLabelFontSize}"
                                                                               FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               Foreground="{Binding EffectiveLabelBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding IsStaticTextLayer, Converter={StaticResource BoolToVis}}" />

                                                                    <!-- 2. Lớp Thông số chuẩn (Label+Value / ValueOnly / LabelOnly + 3 kiểu căn chỉnh) -->
                                                                    <Grid Visibility="{Binding IsStandardMetric, Converter={StaticResource BoolToVis}}">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                    Visibility="{Binding IsInlineLayout, Converter={StaticResource BoolToVis}}">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding EffectiveInlineGapMargin}"
                                                                                        Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                                                                <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}" FontSize="{Binding EffectiveIconFontSize}" Foreground="{Binding EffectiveLabelBrush}" VerticalAlignment="Center"
                                                                                               Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                                                                <TextBlock Text="{Binding DisplayLabel}"
                                                                                           FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           FontSize="{Binding EffectiveLabelFontSize}"
                                                                                           FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Metric.FormattedValue}"
                                                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       FontSize="{Binding EffectiveFontSize}"
                                                                                       FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       Foreground="{Binding EffectiveValueBrush}"
                                                                                       Typography.NumeralAlignment="Tabular"
                                                                                       VerticalAlignment="Center"
                                                                                       Visibility="{Binding ShowValuePart, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>

                                                                        <DockPanel VerticalAlignment="Center" LastChildFill="False"
                                                                                   Visibility="{Binding IsSpaceBetweenLayout, Converter={StaticResource BoolToVis}}">
                                                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding EffectiveInlineGapMargin}"
                                                                                        Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                                                                <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}" FontSize="{Binding EffectiveIconFontSize}" Foreground="{Binding EffectiveLabelBrush}" VerticalAlignment="Center"
                                                                                               Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                                                                <TextBlock Text="{Binding DisplayLabel}"
                                                                                           FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           FontSize="{Binding EffectiveLabelFontSize}"
                                                                                           FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                                                            </StackPanel>
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Metric.FormattedValue}"
                                                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       FontSize="{Binding EffectiveFontSize}"
                                                                                       FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       Foreground="{Binding EffectiveValueBrush}"
                                                                                       Typography.NumeralAlignment="Tabular"
                                                                                       VerticalAlignment="Center"
                                                                                       Visibility="{Binding ShowValuePart, Converter={StaticResource BoolToVis}}" />
                                                                        </DockPanel>

                                                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center"
                                                                                    Visibility="{Binding IsStackedLayout, Converter={StaticResource BoolToVis}}">
                                                                            <StackPanel Orientation="Horizontal" Margin="{Binding EffectiveStackedGapMargin}"
                                                                                        Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                                                                <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}" FontSize="{Binding EffectiveIconFontSize}" Foreground="{Binding EffectiveLabelBrush}" VerticalAlignment="Center"
                                                                                               Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                                                                <TextBlock Text="{Binding DisplayLabel}"
                                                                                           FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           FontSize="{Binding EffectiveLabelFontSize}"
                                                                                           FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Metric.FormattedValue}"
                                                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       FontSize="{Binding EffectiveFontSize}"
                                                                                       FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       Foreground="{Binding EffectiveValueBrush}"
                                                                                       Typography.NumeralAlignment="Tabular"
                                                                                       Visibility="{Binding ShowValuePart, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- 3. Lớp Đồ thị FPS -->
                                                                    <StackPanel MinWidth="140" Visibility="{Binding IsGraphMetric, Converter={StaticResource BoolToVis}}">
                                                                        <DockPanel Margin="0,0,0,3" Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Metric.FormattedValue}"
                                                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       FontSize="{Binding EffectiveLabelFontSize}"
                                                                                       FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       Foreground="{Binding EffectiveValueBrush}"
                                                                                       Typography.NumeralAlignment="Tabular"
                                                                                       VerticalAlignment="Center" />
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}" FontSize="{Binding EffectiveIconFontSize}" Foreground="{Binding EffectiveLabelBrush}" VerticalAlignment="Center"
                                                                                               Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                                                                <TextBlock Text="{Binding DisplayLabel}"
                                                                                           FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           FontSize="{Binding EffectiveLabelFontSize}"
                                                                                           FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                                                            </StackPanel>
                                                                        </DockPanel>
                                                                        <controls:FpsGraphControl Height="{Binding EffectiveGraphHeight}"
                                                                                                  Points="{Binding DataContext.FpsGraphHistory, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                  BaseLineBrush="{Binding DataContext.FpsGraphBaseBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                  FrameGenLineBrush="{Binding DataContext.FpsGraphFrameGenBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    </StackPanel>

                                                                    <!-- 4. Lớp Dãy Huy hiệu Công nghệ GPU -->
                                                                    <StackPanel Visibility="{Binding IsGpuBadgesMetric, Converter={StaticResource BoolToVis}}">
                                                                        <ItemsControl ItemsSource="{Binding DataContext.ActiveGpuBadges, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,1,5,1">
                                                                                        <TextBlock Text="{Binding Label}"
                                                                                                   FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                   FontSize="{Binding DataContext.WidgetBadgeFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                   FontWeight="Bold" Foreground="{Binding TextBrush}" />
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <StackPanel.Style>
                                                                                <Style TargetType="StackPanel">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding DataContext.HasActiveGpuBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </StackPanel.Style>
                                                                            <TextBlock Text="{Binding DisplayLabel}"
                                                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       FontSize="{Binding EffectiveLabelFontSize}"
                                                                                       Foreground="{Binding EffectiveLabelBrush}" Margin="0,0,6,0" />
                                                                            <TextBlock Text="--"
                                                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       FontSize="{Binding EffectiveFontSize}"
                                                                                       Foreground="{Binding EffectiveValueBrush}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Khung viền xanh cyan khi chọn hoặc di chuột (kiểu RTSS Overlay Editor) -->
                                                            <Border IsHitTestVisible="False" Margin="-1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=LayerRootGrid}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="#6660CDFF" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="#FF60CDFF" />
                                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <!-- 3 Tay nắm co giãn kích thước (Phải / Dưới / Góc phải dưới) khi lớp đang được chọn -->
                                                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="E" Width="6" Height="16"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-3,0" Cursor="SizeWE"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" />
                                                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="S" Width="16" Height="6"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3" Cursor="SizeNS"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" />
                                                            <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="SE" Width="8" Height="8"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Cursor="SizeNWSE"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                   DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>

                                <!-- Thanh trạng thái chân Canvas kiểu RTSS (X, Y, W×H, Z & Số lớp) -->
                                <Border Grid.Row="2" Background="#12000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,7,0,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#2260CDFF" CornerRadius="8" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LayerCountText}" FontSize="11" FontWeight="SemiBold" Foreground="#8AE0FF" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedLayerStatusBarText}" FontSize="11" Foreground="#D0FFFFFF" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- CỘT PHẢI: TÙY CHỈNH LỚP ĐANG CHỌN & KIỂU CHUNG / KHUNG -->
                        <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}" Padding="10">
                            <TabControl SelectedIndex="{Binding RightInspectorTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">

                                <!-- SUB-TAB A: LỚP ĐANG CHỌN -->
                                <TabItem Header="{Binding [InspectorSelectedLayer], Source={x:Static services:LocalizationService.Instance}}">
                                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                        <Grid>
                                            <TextBlock Text="{Binding [SelectLayerHint], Source={x:Static services:LocalizationService.Instance}}"
                                                       FontSize="12" Foreground="#90FFFFFF" TextWrapping="Wrap" TextAlignment="Center" Margin="14,32"
                                                       Visibility="{Binding HasNoSelectedLayer, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Visibility="{Binding HasSelectedLayer, Converter={StaticResource BoolToVis}}">
                                                <!-- Tiêu đề lớp + Tọa độ + Đặt lại -->
                                                <DockPanel Margin="0,0,0,9">
                                                    <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnResetMetric], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetSelectedLayerStyleCommand}" Appearance="Secondary" Padding="8,4" FontSize="11" />
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding SelectedLayer.LayerTitle}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SelectedLayer.GeometrySummary}" FontSize="10.8" Foreground="#60CDFF" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Vị trí & Kích thước (X, Y, W, H, Z) -->
                                                <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnAutoSize], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding AutoSizeSelectedLayerCommand}" Appearance="Secondary" Padding="7,2" FontSize="10.5" />
                                                            <TextBlock Text="{Binding [LayerGeometryTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <UniformGrid Columns="4" Margin="0,0,0,2">
                                                            <StackPanel Margin="0,0,5,0">
                                                                <TextBlock Text="X" FontSize="10.5" Foreground="#99FFFFFF" Margin="1,0,0,2" />
                                                                <TextBox Text="{Binding SelectedLayer.X, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="NumericTextBox_KeyDown" FontSize="11.5" Padding="5,3" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,5,0">
                                                                <TextBlock Text="Y" FontSize="10.5" Foreground="#99FFFFFF" Margin="1,0,0,2" />
                                                                <TextBox Text="{Binding SelectedLayer.Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="NumericTextBox_KeyDown" FontSize="11.5" Padding="5,3" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,5,0">
                                                                <TextBlock Text="W (0=Auto)" FontSize="10.5" Foreground="#99FFFFFF" Margin="1,0,0,2" />
                                                                <TextBox Text="{Binding SelectedLayer.Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="NumericTextBox_KeyDown" FontSize="11.5" Padding="5,3" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="H (0=Auto)" FontSize="10.5" Foreground="#99FFFFFF" Margin="1,0,0,2" />
                                                                <TextBox Text="{Binding SelectedLayer.Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="NumericTextBox_KeyDown" FontSize="11.5" Padding="5,3" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Nội dung, Chế độ hiển thị (Pill/Đầy đủ), Màu, Cỡ chữ & Lề trong riêng -->
                                                <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,9"
                                                        Visibility="{Binding SelectedLayer.SupportsTextContent, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [CellContentTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,7" />

                                                        <DockPanel Margin="0,0,0,7">
                                                            <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnResetName], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetSelectedLayerLabelCommand}" Appearance="Secondary" Padding="8,4" FontSize="11" Margin="6,0,0,0" />
                                                            <ui:TextBox Text="{Binding SelectedLayer.CustomLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding [CustomLabelPlaceholder], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" />
                                                        </DockPanel>

                                                        <!-- Chế độ hiển thị: Tên + Số | Chỉ Số (Pill) | Chỉ Tên -->
                                                        <StackPanel Visibility="{Binding SelectedLayer.IsMetricLayer, Converter={StaticResource BoolToVis}}" Margin="0,0,0,7">
                                                            <TextBlock Text="{Binding [DisplayModeLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#C8FFFFFF" Margin="0,0,0,3" />
                                                            <ComboBox ItemsSource="{Binding DisplayModeOptions}" SelectedValuePath="Mode" DisplayMemberPath="DisplayName"
                                                                      SelectedValue="{Binding SelectedLayer.DisplayMode, Mode=TwoWay}" Margin="0,0,0,6" />

                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <RadioButton Content="{Binding [HeaderStyleText], Source={x:Static services:LocalizationService.Instance}}" GroupName="LayerHeaderGroup" IsChecked="{Binding SelectedLayer.IsTextHeader, Mode=TwoWay}" Foreground="White" Margin="0,0,14,0" FontSize="11.5" />
                                                                <RadioButton Content="{Binding [HeaderStyleShortIcon], Source={x:Static services:LocalizationService.Instance}}" GroupName="LayerHeaderGroup" IsChecked="{Binding SelectedLayer.IsIconHeader, Mode=TwoWay}" Foreground="White" FontSize="11.5" />
                                                            </StackPanel>

                                                            <ItemsControl ItemsSource="{Binding FluentIconChoices}" Visibility="{Binding SelectedLayer.IsIconHeader, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.SelectLayerIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SymbolName}" ToolTip="{Binding Name}"
                                                                                Width="28" Height="28" Margin="0,0,4,4" Padding="0" Cursor="Hand" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
                                                                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="14" Foreground="White" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- Màu nhãn / chữ -->
                                                        <DockPanel Margin="0,0,0,4">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Border Width="16" Height="16" CornerRadius="4" Background="{Binding SelectedLayer.EffectiveLabelBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                                <TextBox Width="74" FontSize="11" Padding="5,2" Text="{Binding SelectedLayer.LabelColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <ui:Button Content="{Binding [BtnDefaultColor], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ClearSelectedLayerLabelColorCommand}" Appearance="Secondary" Padding="6,2" FontSize="10.5" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding [LabelColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,7">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding DataContext.SelectLayerLabelColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,4,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Màu số liệu (chỉ hiện với lớp thông số) -->
                                                        <StackPanel Visibility="{Binding SelectedLayer.IsMetricLayer, Converter={StaticResource BoolToVis}}">
                                                            <DockPanel Margin="0,0,0,4">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding SelectedLayer.EffectiveValueBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                                    <TextBox Width="74" FontSize="11" Padding="5,2" Text="{Binding SelectedLayer.ValueColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <ui:Button Content="{Binding [BtnDefaultColor], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ClearSelectedLayerValueColorCommand}" Appearance="Secondary" Padding="6,2" FontSize="10.5" Margin="4,0,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding [ValueColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,7">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.SelectLayerValueColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,4,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- Cỡ chữ riêng -->
                                                        <DockPanel Margin="0,2,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.CustomFontSizeLabel}" FontSize="11" Foreground="#60CDFF" VerticalAlignment="Center" Visibility="{Binding SelectedLayer.UseCustomFontSize, Converter={StaticResource BoolToVis}}" />
                                                            <CheckBox Content="{Binding [CustomFontSizeToggle], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding SelectedLayer.UseCustomFontSize, Mode=TwoWay}" FontSize="11.5" Foreground="#D8FFFFFF" />
                                                        </DockPanel>
                                                        <Slider Minimum="10" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.CustomFontSize, Mode=TwoWay}" Visibility="{Binding SelectedLayer.UseCustomFontSize, Converter={StaticResource BoolToVis}}" Margin="0,0,0,5" />

                                                        <!-- Khoảng cách Tên - Số & Căn chỉnh riêng (chỉ lớp thông số chuẩn) -->
                                                        <StackPanel Visibility="{Binding SelectedLayer.IsStandardMetric, Converter={StaticResource BoolToVis}}">
                                                            <DockPanel Margin="0,2,0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.CustomGapLabel}" FontSize="11" Foreground="#60CDFF" VerticalAlignment="Center" Visibility="{Binding SelectedLayer.UseCustomGap, Converter={StaticResource BoolToVis}}" />
                                                                <CheckBox Content="{Binding [CustomGapToggle], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding SelectedLayer.UseCustomGap, Mode=TwoWay}" FontSize="11.5" Foreground="#D8FFFFFF" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.CustomLabelValueGap, Mode=TwoWay}" Visibility="{Binding SelectedLayer.UseCustomGap, Converter={StaticResource BoolToVis}}" Margin="0,0,0,5" />

                                                            <CheckBox Content="{Binding [CustomAlignmentToggle], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding SelectedLayer.UseCustomAlignment, Mode=TwoWay}" FontSize="11.5" Foreground="#D8FFFFFF" Margin="0,2,0,4" />
                                                            <ComboBox ItemsSource="{Binding AlignmentOptions}" SelectedValuePath="Alignment" DisplayMemberPath="DisplayName"
                                                                      SelectedValue="{Binding SelectedLayer.CustomContentAlignment, Mode=TwoWay}"
                                                                      Visibility="{Binding SelectedLayer.UseCustomAlignment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,5" />
                                                        </StackPanel>

                                                        <!-- Lề trong riêng cho lớp -->
                                                        <CheckBox Content="{Binding [CustomPaddingToggle], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding SelectedLayer.UseCustomPadding, Mode=TwoWay}" FontSize="11.5" Foreground="#D8FFFFFF" Margin="0,2,0,4" />
                                                        <StackPanel Visibility="{Binding SelectedLayer.UseCustomPadding, Converter={StaticResource BoolToVis}}">
                                                            <DockPanel Margin="0,0,0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.CustomPaddingHLabel}" FontSize="11" Foreground="#60CDFF" />
                                                                <TextBlock Text="{Binding [CellPaddingHLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#C8FFFFFF" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.CustomPaddingH, Mode=TwoWay}" Margin="0,0,0,4" />

                                                            <DockPanel Margin="0,0,0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.CustomPaddingVLabel}" FontSize="11" Foreground="#60CDFF" />
                                                                <TextBlock Text="{Binding [CellPaddingVLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#C8FFFFFF" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.CustomPaddingV, Mode=TwoWay}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Kiểu dáng phẳng của lớp (Nền, Opacity, Viền, Độ dày, Bo góc) -->
                                                <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,7">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding [UseGlobalCellStyleTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                                <TextBlock Text="{Binding [UseGlobalCellStyleSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#90FFFFFF" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedLayer.UseGlobalStyle, Mode=TwoWay}" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <StackPanel IsEnabled="{Binding SelectedLayer.UseCustomBoxStyle}">
                                                            <TextBlock Text="{Binding [CellFlatBgTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8AE0FF" Margin="0,2,0,5" />
                                                            <DockPanel Margin="0,0,0,4">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding SelectedLayer.BgPreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                                    <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding SelectedLayer.BgColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding [CellBgColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <ItemsControl ItemsSource="{Binding DarkBgPresets}" Margin="0,0,0,6">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.SelectLayerBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,5,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                            <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <DockPanel Margin="0,0,0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.BgOpacityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                                <TextBlock Text="{Binding [CellBgOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.BgOpacity, Mode=TwoWay}" Margin="0,0,0,7" />

                                                            <TextBlock Text="{Binding [CellBorderTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8AE0FF" Margin="0,2,0,5" />
                                                            <CheckBox Content="{Binding [CellBorderEnableLabel], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding SelectedLayer.BorderEnabled, Mode=TwoWay}" FontSize="11.5" Foreground="White" Margin="0,0,0,5" />

                                                            <StackPanel IsEnabled="{Binding SelectedLayer.BorderEnabled}">
                                                                <DockPanel Margin="0,0,0,4">
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                        <Border Width="16" Height="16" CornerRadius="4" Background="{Binding SelectedLayer.BorderPreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                                        <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding SelectedLayer.BorderColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding [CellBorderColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                                </DockPanel>
                                                                <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,6">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.SelectLayerBorderColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,4,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                                <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <DockPanel Margin="0,0,0,2">
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.BorderOpacityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                                    <TextBlock Text="{Binding [CellBorderOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                                </DockPanel>
                                                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.BorderOpacity, Mode=TwoWay}" Margin="0,0,0,5" />

                                                                <DockPanel Margin="0,0,0,2">
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.BorderThicknessLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                                    <TextBlock Text="{Binding [CellBorderThicknessLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                                </DockPanel>
                                                                <Slider Minimum="0.5" Maximum="4.0" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.BorderThicknessValue, Mode=TwoWay}" Margin="0,0,0,5" />
                                                            </StackPanel>

                                                            <DockPanel Margin="0,0,0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedLayer.CornerRadiusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                                <TextBlock Text="{Binding [CellCornerRadiusLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SelectedLayer.CornerRadiusValue, Mode=TwoWay}" Margin="0,0,0,8" />
                                                        </StackPanel>

                                                        <ui:Button Content="{Binding [BtnApplyStyleAllLayers], Source={x:Static services:LocalizationService.Instance}}"
                                                                   Command="{Binding ApplySelectedLayerStyleToAllCommand}"
                                                                   Appearance="Primary" HorizontalAlignment="Stretch" Padding="10,6" FontSize="11.5" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Chiều cao đồ thị FPS khi chọn lớp fps_graph -->
                                                <Border Background="#10FFFFFF" BorderBrush="#2860CDFF" BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                        Visibility="{Binding SelectedLayer.IsGraphMetric, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [FpsGraphCustomizeTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="#8AE0FF" Margin="0,0,0,6" />
                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FpsGraphHeightLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                            <TextBlock Text="{Binding [FpsGraphHeightLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                        </DockPanel>
                                                        <Slider Minimum="24" Maximum="140" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding FpsGraphHeight, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- SUB-TAB B: KIỂU CHUNG, PHÔNG CHỮ & KHUNG TỔNG -->
                                <TabItem Header="{Binding [InspectorGlobalStyle], Source={x:Static services:LocalizationService.Instance}}">
                                    <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                        <StackPanel>
                                            <!-- 1. Phông chữ & Màu chữ chung -->
                                            <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [GlobalTextTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,7" />

                                                    <TextBlock Text="{Binding [FontFamilyLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#C8FFFFFF" Margin="0,0,0,3" />
                                                    <ComboBox ItemsSource="{Binding InstalledFontFamilies}" SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}" Margin="0,0,0,7">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="12.5" /></DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <TextBlock Text="{Binding [FontWeightLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#C8FFFFFF" Margin="0,0,0,3" />
                                                    <ComboBox ItemsSource="{Binding FontWeightOptions}" SelectedItem="{Binding SelectedFontWeightOption, Mode=TwoWay}" Margin="0,0,0,7">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding DisplayName}" FontWeight="{Binding Weight}" FontSize="12" /></DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FontSizeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                        <TextBlock Text="{Binding [GlobalFontSize], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                    </DockPanel>
                                                    <Slider Minimum="10" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize, Mode=TwoWay}" Margin="0,0,0,7" />

                                                    <DockPanel Margin="0,0,0,4">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding GlobalLabelBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                            <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding LabelColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding [GlobalLabelColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,6">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.SelectGlobalLabelColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,4,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <DockPanel Margin="0,0,0,4">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding GlobalValueBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                            <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding TextColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding [GlobalValueColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding ColorPresets}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.SelectGlobalValueColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,4,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- 2. Khoảng cách & Lề mặc định -->
                                            <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [GlobalSpacingTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,7" />

                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CellPaddingHLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                        <TextBlock Text="{Binding [CellPaddingHLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CellPaddingH, Mode=TwoWay}" Margin="0,0,0,6" />

                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CellPaddingVLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                        <TextBlock Text="{Binding [CellPaddingVLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CellPaddingV, Mode=TwoWay}" Margin="0,0,0,7" />

                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GlobalLabelValueGapLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                        <TextBlock Text="{Binding [LabelValueGapLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" FontWeight="Medium" Foreground="#8AE0FF" />
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GlobalLabelValueGap, Mode=TwoWay}" Margin="0,0,0,6" />

                                                    <TextBlock Text="{Binding [ContentAlignmentLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" Margin="0,0,0,4" />
                                                    <ComboBox ItemsSource="{Binding AlignmentOptions}" SelectedValuePath="Alignment" DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding GlobalContentAlignment, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 3. Kiểu dáng phẳng mặc định chung -->
                                            <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [DefaultCellStyleTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,7" />

                                                    <DockPanel Margin="0,0,0,4">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding DefaultCellBgPreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                            <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding DefaultCellBgColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding [CellBgColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding DarkBgPresets}" Margin="0,0,0,6">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.SelectDefaultCellBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,5,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultCellBgOpacityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                        <TextBlock Text="{Binding [CellBgOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DefaultCellBgOpacity, Mode=TwoWay}" Margin="0,0,0,7" />

                                                    <CheckBox Content="{Binding [CellBorderEnableLabel], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding DefaultCellBorderEnabled, Mode=TwoWay}" FontSize="11.5" Foreground="White" Margin="0,0,0,5" />
                                                    <StackPanel IsEnabled="{Binding DefaultCellBorderEnabled}">
                                                        <DockPanel Margin="0,0,0,4">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Border Width="16" Height="16" CornerRadius="4" Background="{Binding DefaultCellBorderPreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                                <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding DefaultCellBorderColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding [CellBorderColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,6">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding DataContext.SelectDefaultCellBorderColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,4,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultCellBorderOpacityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                            <TextBlock Text="{Binding [CellBorderOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                        </DockPanel>
                                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DefaultCellBorderOpacity, Mode=TwoWay}" Margin="0,0,0,5" />

                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultCellBorderThicknessLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                            <TextBlock Text="{Binding [CellBorderThicknessLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                        </DockPanel>
                                                        <Slider Minimum="0.5" Maximum="4.0" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding DefaultCellBorderThickness, Mode=TwoWay}" Margin="0,0,0,5" />
                                                    </StackPanel>

                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultCellCornerRadiusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                        <TextBlock Text="{Binding [CellCornerRadiusLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DefaultCellCornerRadius, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 4. Nền khung tổng bọc ngoài bảng Overlay -->
                                            <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding [OuterFrameEnableTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                            <TextBlock Text="{Binding [OuterFrameEnableSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="10.5" Foreground="#90FFFFFF" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOuterFrame, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <StackPanel IsEnabled="{Binding ShowOuterFrame}">
                                                        <DockPanel Margin="0,0,0,4">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Border Width="16" Height="16" CornerRadius="4" Background="{Binding OuterFrameBgPreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                                <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding OuterFrameBgColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding [CellBgColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <ItemsControl ItemsSource="{Binding DarkBgPresets}" Margin="0,0,0,6">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding DataContext.SelectOuterFrameBgColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="20" Height="20" Margin="0,0,5,3" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                        <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Brush}" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OuterFrameBgOpacityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                            <TextBlock Text="{Binding [CellBgOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                        </DockPanel>
                                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OuterFrameBgOpacity, Mode=TwoWay}" Margin="0,0,0,5" />

                                                        <CheckBox Content="{Binding [CellBorderEnableLabel], Source={x:Static services:LocalizationService.Instance}}" IsChecked="{Binding OuterFrameBorderEnabled, Mode=TwoWay}" FontSize="11.5" Foreground="White" Margin="0,0,0,5" />
                                                        <StackPanel IsEnabled="{Binding OuterFrameBorderEnabled}">
                                                            <DockPanel Margin="0,0,0,4">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Border Width="16" Height="16" CornerRadius="4" Background="{Binding OuterFrameBorderPreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,5,0" />
                                                                    <TextBox Width="78" FontSize="11" Padding="5,2" Text="{Binding OuterFrameBorderColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding [CellBorderColorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <DockPanel Margin="0,0,0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding OuterFrameBorderOpacityLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                                <TextBlock Text="{Binding [CellBorderOpacityLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OuterFrameBorderOpacity, Mode=TwoWay}" Margin="0,0,0,5" />

                                                            <DockPanel Margin="0,0,0,2">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding OuterFrameBorderThicknessLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                                <TextBlock Text="{Binding [CellBorderThicknessLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                            </DockPanel>
                                                            <Slider Minimum="0.5" Maximum="4.0" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding OuterFrameBorderThickness, Mode=TwoWay}" Margin="0,0,0,5" />
                                                        </StackPanel>

                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OuterFrameCornerRadiusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                            <TextBlock Text="{Binding [CornerRadiusLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                        </DockPanel>
                                                        <Slider Minimum="0" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OuterFrameCornerRadius, Mode=TwoWay}" Margin="0,0,0,5" />

                                                        <DockPanel Margin="0,0,0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OuterFramePaddingLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" />
                                                            <TextBlock Text="{Binding [OuterFramePaddingLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#D0FFFFFF" />
                                                        </DockPanel>
                                                        <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OuterFramePadding, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================================================ -->
            <!-- TAB 2: CÔNG NGHỆ GPU 3 LỚP & HỖ TRỢ HYBRID 2 GPU -->
            <!-- ================================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:SymbolIcon Symbol="Games24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [TabGpuTech], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [HideUnsupported], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:ToggleSwitch IsChecked="{Binding HideUnsupportedGpuTechs, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [GpuDetectedTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding [GpuDetectedHybridSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding DetectedGpus}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding VendorAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="12" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                                                    <Border Background="#2C4ADE80" BorderBrush="#884ADE80" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                                            Visibility="{Binding IsActiveRenderingGpu, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding RenderingStatusBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="#86EFAC" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [BadgeColorTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                        <WrapPanel VerticalAlignment="Center">
                                            <RadioButton Content="{Binding [BadgeColorVendor], Source={x:Static services:LocalizationService.Instance}}" GroupName="GpuBadgeColorMode" IsChecked="{Binding UseVendorGpuBadgeColor, Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,4" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <RadioButton Content="{Binding [BadgeColorCustom], Source={x:Static services:LocalizationService.Instance}}" GroupName="GpuBadgeColorMode" IsChecked="{Binding UseCustomGpuBadgeColor, Mode=TwoWay}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding CustomGpuBadgePreviewBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBox Width="88" FontSize="11.5" Padding="6,3" Text="{Binding CustomGpuBadgeColorHex, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomGpuBadgeColor}" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Ghi đè nhanh theo từng .exe + Nguồn phát hiện 3 lớp -->
                        <Border Style="{StaticResource SectionCardStyle}" BorderBrush="#3C60CDFF" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnResetAuto], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ClearCurrentGameOverridesCommand}" Appearance="Secondary" Padding="10,5" IsEnabled="{Binding HasOverrideTargetGame}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding [QuickOverrideTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="#8AE0FF" />
                                        <TextBlock Text="{Binding [QuickOverrideSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#A0FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="#1260CDFF" CornerRadius="7" Padding="10,6" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding GpuDetectionStatusText}" FontSize="11.5" Foreground="#E5FFFFFF" TextWrapping="Wrap" />
                                </Border>

                                <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverrideTargetGameDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,6" />
                                    <ComboBox ItemsSource="{Binding SavedGameProfileNames}" SelectedItem="{Binding CurrentOverrideGameExe, Mode=TwoWay}" MinWidth="180" Margin="0,0,10,6" ToolTip="{Binding [TooltipGameProfileCombo], Source={x:Static services:LocalizationService.Instance}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:TextBox Width="175" Text="{Binding ManualGameExeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding [ManualExePlaceholder], Source={x:Static services:LocalizationService.Instance}}" Margin="0,0,6,0" />
                                        <ui:Button Content="{Binding [BtnCreateSelect], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ApplyManualGameExeCommand}" Appearance="Secondary" Padding="10,6" />
                                    </StackPanel>
                                </WrapPanel>

                                <Border Background="#10000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding [BadgesOnWidgetLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ItemsControl ItemsSource="{Binding ActiveGpuBadges}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,1,6,1">
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding TextBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding SupportedGpuTechItems}" IsEnabled="{Binding HasOverrideTargetGame}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.CycleTechOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="10,7" Margin="0,0,8,8" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#14FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#24FFFFFF" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverrideForceOn}" Value="True">
                                                                <Setter Property="Background" Value="#284ADE80" />
                                                                <Setter Property="BorderBrush" Value="#AA4ADE80" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOverrideForceOff}" Value="True">
                                                                <Setter Property="Background" Value="#24F87171" />
                                                                <Setter Property="BorderBrush" Value="#99F87171" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="6" Background="#20000000" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OverrideLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                                                        <TextBlock Text="{Binding EffectiveSourceLabel}" FontSize="10.5" Foreground="#8AE0FF" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 3 Nhóm công nghệ: NVIDIA / AMD / Intel -->
                        <ItemsControl ItemsSource="{Binding GpuTechGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12"
                                            Opacity="{Binding GroupOpacity}" IsEnabled="{Binding IsSupported}"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="10" Background="#1CFFFFFF" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SupportBadgeText}" FontSize="11.5" FontWeight="Medium" Foreground="#E0FFFFFF" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="4" Height="28" CornerRadius="2" Background="{Binding AccentBrush}" Margin="0,0,10,0" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#12FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,8,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                                        <Border Background="#1E60CDFF" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding EffectiveSourceLabel}" FontSize="10" Foreground="#8AE0FF" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#95FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================ -->
            <!-- TAB 3: VỊ TRÍ OSD (9 ĐIỂM NEO + ĐA MÀN HÌNH), FPS & HỆ THỐNG -->
            <!-- ================================================================ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [TabOverlaySystem], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: VỊ TRÍ OSD 9 ĐIỂM NEO + FPS PRESENTMON -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding [OsdPositionTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding [OsdPureNote], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#8AE0FF" TextWrapping="Wrap" Margin="0,3,0,12" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [AlwaysOnTopTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding [AlwaysOnTopSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsWidgetTopmost, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [HotkeyToggleTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding [HotkeyToggleSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableToggleOverlayHotkey, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Chọn màn hình hiển thị -->
                                    <DockPanel Margin="0,0,0,12">
                                        <ui:Button DockPanel.Dock="Right" Content="{Binding [BtnRefreshMonitors], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding RefreshMonitorsCommand}" Appearance="Secondary" Padding="10,5" Margin="8,0,0,0" />
                                        <ComboBox DockPanel.Dock="Right" Width="230" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                                        <TextBlock Text="{Binding [MonitorLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Bảng chọn 9 điểm neo màn hình -->
                                    <TextBlock Text="{Binding [AnchorGridLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" FontWeight="Medium" Foreground="#E0FFFFFF" Margin="0,0,0,6" />
                                    <UniformGrid Rows="3" Columns="3" Margin="0,0,0,12">
                                        <Button Content="{Binding [AnchorTopLeft], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="TopLeft">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorTopLeft}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorTopCenter], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="TopCenter">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorTopCenter}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorTopRight], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="TopRight">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorTopRight}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorMidLeft], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="MiddleLeft">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorMiddleLeft}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorMidCenter], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="MiddleCenter">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorMiddleCenter}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorMidRight], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="MiddleRight">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorMiddleRight}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorBotLeft], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="BottomLeft">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorBottomLeft}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorBotCenter], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="BottomCenter">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorBottomCenter}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="{Binding [AnchorBotRight], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding SetAnchorCommand}" CommandParameter="BottomRight">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAnchorBottomRight}" Value="True"><Setter Property="Background" Value="#3860CDFF" /><Setter Property="BorderBrush" Value="#FF60CDFF" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                    </UniformGrid>

                                    <!-- Thanh trượt căn lề X / Y (px) -->
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OverlayOffsetXLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        <TextBlock Text="{Binding [OffsetXLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#E0FFFFFF" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="600" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayOffsetX, Mode=TwoWay}" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OverlayOffsetYLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        <TextBlock Text="{Binding [OffsetYLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12" Foreground="#E0FFFFFF" />
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="600" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayOffsetY, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- FPS & PresentMon 2.x -->
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [FpsSettingsTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding [FpsSettingsSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [AutoHideFpsTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHideFpsWhenIdle, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [AutoHideFgTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHideFrameGenWhenInactive, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FpsGraphHeightLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF" />
                                        <TextBlock Text="{Binding [FpsGraphHeightLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="12.5" Foreground="#E0FFFFFF" />
                                    </DockPanel>
                                    <Slider Minimum="24" Maximum="140" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding FpsGraphHeight, Mode=TwoWay}" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding [FpsBaseLineColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#C8FFFFFF" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding FpsGraphBaseBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding FpsGraphBaseColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding [FpsFgLineColor], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#C8FFFFFF" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="4" Background="{Binding FpsGraphFrameGenBrush}" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                                                <TextBox Width="86" FontSize="11.5" Padding="6,3" Text="{Binding FpsGraphFrameGenColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,4,0,6">
                                        <ui:Button Content="{Binding [BtnResetFpsFull], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetFpsStatsCommand}" Appearance="Secondary" Padding="10,5" Margin="0,0,8,4" />
                                        <ui:Button Content="{Binding [BtnUpdatePresentMon], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding DownloadPresentMonCommand}" Appearance="Secondary" Padding="10,5" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding PresentMonPathDisplay}" FontSize="11" Foreground="#8AE0FF" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PresentMonDownloadFeedback}" FontSize="11" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- CỘT PHẢI: HỆ THỐNG, NGÔN NGỮ, CẬP NHẬT & CẤU HÌNH -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SystemTrayTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding [LanguageLabel], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" />
                                        <ComboBox DockPanel.Dock="Right" Width="210" ItemsSource="{Binding SupportedLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" DisplayMemberPath="NativeName" />
                                    </DockPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [RunAtStartupTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding [RunAtStartupSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StartupStatusFeedback}" FontSize="11" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding RunAtWindowsStartup, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [MinToTrayTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding [MinToTraySub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Cập nhật phần mềm từ GitHub Releases -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="#2260CDFF" BorderBrush="#5560CDFF" BorderThickness="1" CornerRadius="8" Padding="9,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentVersionDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#8AE0FF" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [UpdateSectionTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding GitHubRepoDisplay}" FontSize="11.5" Foreground="#90FFFFFF" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding [AutoCheckUpdateTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="13" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding [AutoCheckUpdateSub], Source={x:Static services:LocalizationService.Instance}}" FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckUpdatesOnStartup, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>

                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Left" Content="{Binding [BtnCheckUpdates], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckUpdates}" Appearance="Primary" Padding="14,6" />
                                        <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="11.5" Foreground="#8AE0FF" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [ConfigFileTitle], Source={x:Static services:LocalizationService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ConfigFilePath}" FontSize="11.5" Foreground="#8AE0FF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Thanh chân trang -->
        <Border Grid.Row="3" Margin="18,0,18,14" Padding="14,8" Background="#0EFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="{Binding [BtnResetDefaults], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ResetDefaultsCommand}" Appearance="Secondary" Padding="12,5" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding [BtnExitApp], Source={x:Static services:LocalizationService.Instance}}" Command="{Binding ExitAppCommand}" Appearance="Danger" Padding="12,5" />
                </StackPanel>

                <TextBlock Text="{Binding CloseBehaviorFooterText}" FontSize="11.5" Foreground="#90FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
