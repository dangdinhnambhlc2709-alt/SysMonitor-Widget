<Window x:Class="WinHardwareMonitor.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:WinHardwareMonitor.Controls"
        xmlns:services="clr-namespace:WinHardwareMonitor.Services"
        Title="{Binding [WidgetWindowTitle], Source={x:Static services:LocalizationService.Instance}}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsWidgetTopmost, Mode=OneWay}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{Binding SelectedFontFamily}">

    <Window.Resources>
        <Style x:Key="OsdLayerContainerStyle" TargetType="ContentPresenter">
            <Setter Property="controls:OverlayCanvasPanel.X" Value="{Binding X}" />
            <Setter Property="controls:OverlayCanvasPanel.Y" Value="{Binding Y}" />
            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisibleOnOverlay}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Overlay OSD thuần túy: WYSIWYG 100% theo Canvas thiết kế, siêu nhẹ, xuyên chuột tuyệt đối -->
    <Grid IsHitTestVisible="False">
        <Border Background="{Binding EffectiveOuterFrameBackground}"
                BorderBrush="{Binding EffectiveOuterFrameBorderBrush}"
                BorderThickness="{Binding EffectiveOuterFrameBorderThickness}"
                CornerRadius="{Binding EffectiveOuterFrameCornerRadius}"
                Padding="{Binding EffectiveOuterFramePadding}"
                SnapsToDevicePixels="True">

            <ItemsControl ItemsSource="{Binding OverlayLayers}"
                          ItemContainerStyle="{StaticResource OsdLayerContainerStyle}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:OverlayCanvasPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding RenderWidth}"
                                Height="{Binding RenderHeight}"
                                Background="{Binding EffectiveBackgroundBrush}"
                                BorderBrush="{Binding EffectiveBorderBrush}"
                                BorderThickness="{Binding EffectiveBorderThickness}"
                                CornerRadius="{Binding EffectiveCornerRadius}"
                                Padding="{Binding EffectivePadding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- 1. Lớp Nhãn chữ tĩnh (StaticText) -->
                                <TextBlock Text="{Binding DisplayLabel}"
                                           FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="{Binding EffectiveLabelFontSize}"
                                           FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding EffectiveLabelBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsStaticTextLayer, Converter={StaticResource BoolToVis}}" />

                                <!-- 2. Lớp Thông số chuẩn (Label+Value / ValueOnly / LabelOnly + 3 kiểu căn chỉnh) -->
                                <Grid Visibility="{Binding IsStandardMetric, Converter={StaticResource BoolToVis}}">
                                    <!-- 2A. Liền nhau theo khoảng cách -->
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsInlineLayout, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding EffectiveInlineGapMargin}"
                                                    Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}"
                                                           FontSize="{Binding EffectiveIconFontSize}"
                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="{Binding EffectiveLabelFontSize}"
                                                       FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{Binding EffectiveLabelBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metric.FormattedValue}"
                                                   FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding EffectiveFontSize}"
                                                   FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{Binding EffectiveValueBrush}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowValuePart, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- 2B. Căn 2 đầu trái - phải -->
                                    <DockPanel VerticalAlignment="Center"
                                               LastChildFill="False"
                                               Visibility="{Binding IsSpaceBetweenLayout, Converter={StaticResource BoolToVis}}">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding EffectiveInlineGapMargin}"
                                                    Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}"
                                                           FontSize="{Binding EffectiveIconFontSize}"
                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="{Binding EffectiveLabelFontSize}"
                                                       FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{Binding EffectiveLabelBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Metric.FormattedValue}"
                                                   FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding EffectiveFontSize}"
                                                   FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{Binding EffectiveValueBrush}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowValuePart, Converter={StaticResource BoolToVis}}" />
                                    </DockPanel>

                                    <!-- 2C. Xếp dọc -->
                                    <StackPanel Orientation="Vertical"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsStackedLayout, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Margin="{Binding EffectiveStackedGapMargin}"
                                                    Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}"
                                                           FontSize="{Binding EffectiveIconFontSize}"
                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="{Binding EffectiveLabelFontSize}"
                                                       FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{Binding EffectiveLabelBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Metric.FormattedValue}"
                                                   FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding EffectiveFontSize}"
                                                   FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{Binding EffectiveValueBrush}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Visibility="{Binding ShowValuePart, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 3. Lớp Đồ thị FPS -->
                                <StackPanel MinWidth="140"
                                            Visibility="{Binding IsGraphMetric, Converter={StaticResource BoolToVis}}">
                                    <DockPanel Margin="0,0,0,3" Visibility="{Binding ShowHeaderPart, Converter={StaticResource BoolToVis}}">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Metric.FormattedValue}"
                                                   FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding EffectiveLabelFontSize}"
                                                   FontWeight="{Binding DataContext.WidgetValueFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{Binding EffectiveValueBrush}"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}"
                                                           FontSize="{Binding EffectiveIconFontSize}"
                                                           Foreground="{Binding EffectiveLabelBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="{Binding EffectiveLabelFontSize}"
                                                       FontWeight="{Binding DataContext.WidgetLabelFontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{Binding EffectiveLabelBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <controls:FpsGraphControl Height="{Binding EffectiveGraphHeight}"
                                                              Points="{Binding DataContext.FpsGraphHistory, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              BaseLineBrush="{Binding DataContext.FpsGraphBaseBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              FrameGenLineBrush="{Binding DataContext.FpsGraphFrameGenBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>

                                <!-- 4. Lớp Dãy Huy hiệu Công nghệ GPU -->
                                <StackPanel Visibility="{Binding IsGpuBadgesMetric, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding DataContext.ActiveGpuBadges, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,1,5,1">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               FontSize="{Binding DataContext.WidgetBadgeFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding TextBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.HasActiveGpuBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="{Binding EffectiveSymbol}"
                                                       FontSize="{Binding EffectiveIconFontSize}"
                                                       Foreground="{Binding EffectiveLabelBrush}"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding ShowIconPart, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding EffectiveLabelFontSize}"
                                                   Foreground="{Binding EffectiveLabelBrush}"
                                                   Margin="0,0,6,0"
                                                   Visibility="{Binding ShowTextLabelPart, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="--"
                                                   FontFamily="{Binding DataContext.SelectedFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{Binding EffectiveFontSize}"
                                                   Foreground="{Binding EffectiveValueBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
