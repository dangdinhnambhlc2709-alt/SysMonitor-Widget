<ui:FluentWindow x:Class="WinHardwareMonitor.Views.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:services="clr-namespace:WinHardwareMonitor.Services"
                 Title="{Binding [UpdateWinTitle], Source={x:Static services:LocalizationService.Instance}}"
                 FlowDirection="{Binding FlowDirection, Source={x:Static services:LocalizationService.Instance}}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="520"
                 Height="450"
                 MinWidth="460"
                 MinHeight="380"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding [UpdateWinTitleFull], Source={x:Static services:LocalizationService.Instance}}"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="22,8,22,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tiêu đề & số phiên bản -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding [UpdateWinHeader], Source={x:Static services:LocalizationService.Instance}}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White" />

                <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                    <Border Background="#18FFFFFF" CornerRadius="7" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="CurrentVersionBadge"
                                   FontSize="12"
                                   Foreground="#C8FFFFFF" />
                    </Border>
                    <TextBlock Text="→" FontSize="14" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="#284ADE80" BorderBrush="#884ADE80" BorderThickness="1" CornerRadius="7" Padding="10,4">
                        <TextBlock x:Name="NewVersionBadge"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#86EFAC" />
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Nhãn danh sách thay đổi -->
            <TextBlock Grid.Row="1"
                       Text="{Binding [UpdateNotesLabel], Source={x:Static services:LocalizationService.Instance}}"
                       FontSize="12.5"
                       FontWeight="Medium"
                       Foreground="#D8FFFFFF"
                       Margin="0,0,0,6" />

            <!-- Nội dung thay đổi có thanh cuộn -->
            <Border Grid.Row="2"
                    Background="#12FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ReleaseNotesTextBlock"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               LineHeight="20"
                               Foreground="#E8FFFFFF" />
                </ScrollViewer>
            </Border>

            <!-- Thanh tiến trình tải xuống (chỉ hiện khi bấm Tải và cài ngay) -->
            <StackPanel x:Name="DownloadProgressPanel"
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                <DockPanel Margin="0,0,0,5">
                    <TextBlock x:Name="ProgressPercentText"
                               DockPanel.Dock="Right"
                               Text="0%"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#60CDFF"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="ProgressDetailText"
                               Text="{Binding [UpdatePreparingShort], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="12"
                               Foreground="#DCE0E8"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0" />
                </DockPanel>
                <ProgressBar x:Name="DownloadProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Height="8"
                             Value="0" />
            </StackPanel>
        </Grid>

        <!-- 2 nút hành động -->
        <Border Grid.Row="2"
                Background="#0EFFFFFF"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="LaterButton"
                               Content="{Binding [UpdateBtnLater], Source={x:Static services:LocalizationService.Instance}}"
                               Appearance="Secondary"
                               Padding="16,7"
                               Margin="0,0,10,0"
                               Click="LaterButton_Click" />
                    <ui:Button x:Name="InstallNowButton"
                               Content="{Binding [UpdateBtnInstall], Source={x:Static services:LocalizationService.Instance}}"
                               Appearance="Primary"
                               Padding="18,7"
                               Click="InstallNowButton_Click" />
                </StackPanel>

                <TextBlock x:Name="StatusHintText"
                           Text="{Binding [UpdateFooterHint], Source={x:Static services:LocalizationService.Instance}}"
                           FontSize="11.5"
                           Foreground="#90FFFFFF"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
